# ChatBot-AI environment example
# Copy to .env and fill in your values

# Backend
PORT=5000
FLASK_ENV=development
LLAMA_SERVER_URL=http://localhost:8080

# App settings
APP_MODE=rag
LOG_LEVEL=INFO
MAX_INPUT_LENGTH=2000
MAX_TOKENS=180
TEMPERATURE=0.3

# Security
ENABLE_PROMPT_SANITIZER=true
ENABLE_RATE_LIMIT=false

# Demo mode fallback
DEMO_MODE=true
